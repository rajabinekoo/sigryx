# Sigryx local/development configuration.
#
# Quick start:
#   cp .env.example .env
#   docker compose up --build -d
#
# The Docker image itself does not bake in SETUP_TOKEN or AUTH_JWT_SECRET.
# Replace the development examples below before using Sigryx outside local dev.

# ---- Docker Compose ----
SIGRYX_IMAGE=sigryx:dev
SIGRYX_PORT=8080
POSTGRES_PORT=5432
POSTGRES_USER=sigryx
POSTGRES_PASSWORD=sigryx
POSTGRES_DB=sigryx
# ---- Application identity / logging ----
SERVICE_NAME=sigryx
LOG_LEVEL=info
LOG_FORMAT=json

# ---- PostgreSQL ----
# Sigryx application objects live in this schema. `vault` is the default.
# Use `public` only when you explicitly want the legacy public schema.
POSTGRES_SCHEMA=vault
# The single Sigryx image contains Atlas and applies pending migrations before
# starting the server. Set false when migrations are managed by deployment CI.
POSTGRES_AUTO_MIGRATE=true
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=2
POSTGRES_CONNECT_TIMEOUT=5s
POSTGRES_MAX_CONN_LIFETIME=30m
POSTGRES_MAX_CONN_IDLE_TIME=5m

# ---- HTTP server ----
# The repository Compose stack always runs Sigryx on 0.0.0.0:8080 inside the
# container and publishes it using SIGRYX_PORT above. This avoids host/internal
# port mismatches during local development.
#
# HTTP_ADDR remains the real Sigryx server bind address for direct `docker run`,
# Kubernetes, systemd, or native execution. Example: HTTP_ADDR=0.0.0.0:9091.
# The bundled compose.yml intentionally sets it internally to 0.0.0.0:8080.
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s

# ---- Authentication ----
# One-time bootstrap token used only by POST /v1/setup. Minimum 32 characters.
SETUP_TOKEN=sigryx-local-setup-token-change-before-production
# HS256 signing secret. Minimum 32 bytes. Use a cryptographically random value
# in any non-local environment (for example: openssl rand -hex 32).
AUTH_JWT_SECRET=sigryx-local-jwt-secret-change-before-production
AUTH_ISSUER=sigryx
AUTH_AUDIENCE=sigryx-api
AUTH_ACCESS_TTL=10m
AUTH_REFRESH_TTL=168h
# Comma-separated reverse-proxy CIDRs allowed to supply X-Forwarded-For/X-Real-IP.
TRUSTED_PROXY_CIDRS=

# ---- Audit retention ----
# 0 means retain that class forever.
AUDIT_NORMAL_RETENTION_DAYS=30
AUDIT_CRITICAL_RETENTION_DAYS=365
AUDIT_CLEANUP_INTERVAL=6h
AUDIT_CLEANUP_BATCH_SIZE=5000

# ---- Integrity signing / alerting ----
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT=2s

# ---- Vault ----
MAX_UNSEAL_SIZE=10

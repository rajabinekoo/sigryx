SERVICE_NAME=vault

# ---- Logging ----
LOG_LEVEL=info
LOG_FORMAT=json

# ---- Postgres ----
POSTGRES_DSN=postgres://sigryx:sigryx@localhost:5432/sigryx?sslmode=disable
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=2
POSTGRES_CONNECT_TIMEOUT=5s
POSTGRES_MAX_CONN_LIFETIME=30m
POSTGRES_MAX_CONN_IDLE_TIME=5m

# ---- HTTP server ----
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s

# ---- gRPC ----
GRPC_TIMEOUT=5s
GPRC_MAX_TRIES=3
SERVICE_GRPC_ADDRESS=localhost:50050

# ---- Authentication ----
# One-time bootstrap token used only by POST /v1/setup. Keep empty to disable setup.
SETUP_TOKEN=replace-with-at-least-32-random-characters
# Independent from Vault/HD wallet secrets. Use at least 32 random bytes.
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_ISSUER=sigryx
AUTH_AUDIENCE=sigryx-api
AUTH_ACCESS_TTL=10m
AUTH_REFRESH_TTL=168h
# Comma-separated reverse-proxy CIDRs allowed to supply X-Forwarded-For/X-Real-IP.
TRUSTED_PROXY_CIDRS=

# ---- AppEnv ----
MAX_UNSEAL_SIZE=10
